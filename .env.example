# Copia este fichero a `.env` (mismo directorio que docker-compose.yml) y rellena lo
# que necesites. Docker Compose lo lee solo; después basta con `docker compose up -d`.
#
# `.env` está en .gitignore: las claves no salen de tu máquina.

# ── Artificial Analysis (opcional) ────────────────────────────────────────────────
# Amplía la cobertura del Intelligence Index. La app ya trae medidos los modelos
# conocidos; esta clave sirve para los que van saliendo, que en el tier gratuito son
# muchos. Es gratis (100 peticiones/24 h): crea cuenta en
# https://artificialanalysis.ai/ y genera una clave en la sección de API.
ARTIFICIAL_ANALYSIS_API_KEY=

# ── Panel (OBLIGATORIO) ───────────────────────────────────────────────────────────
# Contraseña del panel. Sin ella el servidor NO arranca: el panel gestiona las claves
# de todos tus proveedores y no puede quedar abierto por un descuido.
FREEROUTER_PASSWORD=

# Alternativa para uso solo en local, sin contraseña. Nunca en un servidor accesible.
# FREEROUTER_DISABLE_AUTH=true

# Si sirves el panel detrás de HTTPS, marca la cookie de sesión como segura:
# FREEROUTER_HTTPS=true

# ── Cifrado en reposo (opcional) ──────────────────────────────────────────────────
# Si la pones, la clave maestra se deriva de esta frase con scrypt en vez de guardarse
# como fichero. Si la pierdes, las claves de proveedor guardadas dejan de descifrarse.
FREEROUTER_PASSPHRASE=

# ── Exponerlo a internet (opcional) ───────────────────────────────────────────────
# Dos métodos, cada uno un perfil de docker-compose. Ver el README.
#
# Método 1 · IP pública + dominio:  docker compose --profile https up -d
# FREEROUTER_DOMAIN=freerouter.tudominio.com
# ACME_EMAIL=tu@correo.com
#
# Método 2 · sin IP pública (CGNAT, casa):  docker compose --profile tunnel up -d
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...
#
# Con cualquiera de los dos, deja de publicar el 8787 al exterior para que nadie pueda
# saltarse el HTTPS yendo al puerto directo:
# FREEROUTER_BIND=127.0.0.1
